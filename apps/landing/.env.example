# apps/landing on Node + PostgreSQL (docs/adr/0004). Copy to .env (git-ignored).
#   npm run db:up            (repo root: the shared PostgreSQL)
#   npm run auth:setup       (writes a random SESSION_SECRET into .env)
#   npm run dev              (http://127.0.0.1:8788, migrations run at start)

# account_app's login from the root .env (ACCOUNT_DB_PASSWORD; URL-encode special characters)
DATABASE_URL=postgres://account_app:change-me-account@127.0.0.1:5432/naka
APP_ORIGIN=http://127.0.0.1:8788
PORT=8788
SMS_PROVIDER=mock
# MEDIA_DIR=./.media          # clip uploads (R2 stand-in); unset = uploads off
# NAKA_ROLE=all               # web | cron | all

# Same names as the Worker's vars/secrets (src/types.ts Env), for example:
# ADMIN_TOKEN=
# STUDIO_ADMIN_TOKEN=      # naka-studio's ADMIN_TOKEN: the back office's "ระบบ Studio" page (/admin/studio-system/)
# STUDIO_INTERNAL_URL=     # set by docker-compose.yml (http://studio:5679); for `npm run dev`: http://127.0.0.1:5679
# ADMIN_EMAILS=
# ANTHROPIC_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SETTINGS_KEY=
# SOCIAL_TOKEN_KEY=          # base64 of 32 random bytes (`openssl rand -base64 32`); encrypts Meta page
                             # tokens today and LINE OA secret/token after NAK-12. Env-only (LOCKED, not in
                             # /admin/system/). Rotation procedure: docs/secret-rotation.md — no re-encryption
                             # tool exists, rotation forces every member to reconnect.
